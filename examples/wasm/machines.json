{"machines":[{"id":"note","description":"Write a note, check it, file it.","initial":"DRAFT","instance":{"kind":"note","refParam":"noteId","refDescription":"The note's id, e.g. N-1.","refPattern":"^N-\\d+$"},"events":{"submit":{"description":"Submit the note's text.","params":[{"name":"text","description":"The note, at least 10 characters.","required":true,"enumValues":[],"pattern":null}]}},"shared":[],"states":[{"name":"DRAFT","description":null,"isFinal":false,"entryPoint":false,"fallback":false,"entry":[{"prompt":{"text":"Draft the note, then fire submit with its text."}}],"exit":[],"on":[{"event":"submit","transitions":[{"target":"FILED","guard":{"host":{"kind":"command","params":{"run":"test \"${#SMLLM_PARAM_TEXT}\" -ge 10"}}},"actions":[{"host":{"kind":"command","params":{"run":"printf \"%s\\n\" \"$SMLLM_PARAM_TEXT\" >> notes.txt"}}}],"reenter":false,"description":null},{"target":"DRAFT","guard":null,"actions":[],"reenter":true,"description":"The note is too short; write more."}]}],"always":[],"paramDescriptions":{}},{"name":"FILED","description":null,"isFinal":true,"entryPoint":false,"fallback":false,"entry":[{"prompt":{"text":"The note is filed."}}],"exit":[],"on":[],"always":[],"paramDescriptions":{}}]}],"idle":[]}
